@model List<PustokApp.Models.Slider>
@{
    ViewData["Title"] = "Sliders";
}

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">Sliders</h1>
        <a href="@Url.Action("Create")" class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm">
            <i class="fas fa-plus fa-sm text-white-50"></i> Create
        </a>
    </div>

    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Sliders List</h6>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Title</th>
                            <th>Description</th>
                            <th>Image</th>
                            <th>Button Text</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Count > 0)
                        {
                            @foreach (var slider in Model)
                            {
                                <tr>
                                    <td>@slider.Id</td>
                                    <td>@slider.Title</td>
                                    <td>@(slider.Description?.Length > 50 ? slider.Description.Substring(0, 50) + "..." : slider.Description)</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(slider.ImageUrl))
                                        {
                                            <img src="@Url.Content(slider.ImageUrl)" alt="@slider.Title" style="max-width: 50px; max-height: 50px;">
                                        }
                                        else
                                        {
                                            <span class="text-muted">No Image</span>
                                        }
                                    </td>
                                    <td>@slider.ButtonText</td>
                                    <td>
                                        <a href="@Url.Action("Edit", "Sliders", new { area = "Manage", id = slider.Id })" class="btn btn-sm btn-warning">Edit</a>
                                        <button type="button" class="btn btn-sm btn-danger" data-id="@slider.Id" data-title="@slider.Title" onclick="openDeleteModal(this)">Delete</button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted">No sliders found</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>