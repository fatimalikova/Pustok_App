@model List<PustokApp.Models.Author>
@{
    ViewData["Title"] = "Authors";
}

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">Authors</h1>
        <a href="@Url.Action("Create")" class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm">
            <i class="fas fa-plus fa-sm text-white-50"></i> Add Author
        </a>
    </div>

    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Authors List</h6>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Full Name</th>
                            <th>Books Count</th>
                            @* <th>Image</th> *@
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Count > 0)
                        {
                            @foreach (var author in Model)
                            {
                                <tr>
                                    <td>@author.Id</td>
                                    <td>@author.FullName</td>
                                    <td>
                                        @if (author.Books != null)
                                        {
                                            <span class="badge badge-primary">@author.Books.Count</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-secondary">0</span>
                                        }
                                    </td>
                                    @* <td>
                                        @if (!string.IsNullOrEmpty(author.ImageUrl))
                                        {
                                            <img src="~/assets/image/@author.ImageUrl" alt="@author.FullName" style="max-width: 50px; max-height: 50px;">
                                        }
                                        else
                                        {
                                            <span class="text-muted">No Image</span>
                                        }
                                    </td> *@
                                    <td>
                                        <a asp-action="Edit" asp-route-id="@author.Id" class="btn btn-info btn-sm">
                                            <i class="fas fa-edit"></i> Edit
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@author.Id" class="btn btn-danger btn-sm deleteAuthor">
                                            <i class="fas fa-trash"></i> Delete
                                        </a>
                                        <a asp-action="Details" asp-route-id="@author.Id" class="btn btn-secondary btn-sm">
                                            <i class="fas fa-info-circle"></i> Details
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted">No authors found</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        $(.deleteAuthor).click(function (e) {
             e.preventDefault();
                     Swal.fire({
          title: "Do you want to delete this author?",
          showDenyButton: true,
          showCancelButton: true,
          confirmButtonText: "Delete",
          denyButtonText: `Don't delete`
        }).then((result) => {
          /* Read more about isConfirmed, isDenied below */
          if (result.isConfirmed) {
              //author/delete/id
              var url = $(this).attr('href');
              $.ajax({
                  url: url,
                  type: 'get',
                  success: function () {
                          Swal.fire("Author deleted successfully!", "", "success").then(() => {
                              location.reload();
                  },
                  error: function () {
                      Swal.fire("An error occurred while deleting the author.", "", "error");
                  }
              });
          }
          
          else if (result.isDenied) Swal.fire("Changes are not saved", "", "info");
        });
         });
    </script>
}
