@model List<PustokApp.Models.Author>

@{
    ViewData["Title"] = "Admin Dashboard";
}

<h1>Admin Dashboard</h1>

<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <h5>Management Links</h5>
            </div>
            <div class="card-body">
                <a asp-area="Manage" asp-controller="Authors" asp-action="Index" class="btn btn-primary">Manage Authors</a>
                <!-- Add more management links here as needed -->
            </div>
        </div>
    </div>
</div>

<h2>Authors Overview</h2>

<table class="table">
    <thead>
        <tr>
            <th>Author ID</th>
            <th>Name</th>
            <th>Image URL</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var author in Model)
        {
            <tr>
                <td>@author.Id</td>
                <td>@author.FullName</td>
                <td>@author.ImageUrl</td>
            </tr>
        }
    </tbody>
</table>
