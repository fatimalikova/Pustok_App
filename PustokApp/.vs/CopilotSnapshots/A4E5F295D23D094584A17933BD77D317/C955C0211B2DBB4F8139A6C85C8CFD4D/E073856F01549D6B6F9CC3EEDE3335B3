@model PustokApp.Models.Author
@{
    ViewData["Title"] = "Delete Author";
}

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">Delete Author</h1>
    </div>

    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Confirm Delete</h6>
        </div>
        <div class="card-body">
            <div class="alert alert-warning">
                <h5>Are you sure you want to delete this author?</h5>
                <p class="mb-0">This action cannot be undone.</p>
            </div>

            <div class="form-group">
                <label class="control-label">Full Name</label>
                <input type="text" class="form-control" value="@Model.FullName" disabled />
            </div>

            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <div class="form-group">
                    <label class="control-label">Image</label>
                    <div>
                        <img src="@Model.ImageUrl" alt="@Model.FullName" style="max-width: 200px; max-height: 200px;">
                    </div>
                </div>
            }

            <form method="post">
                <div class="form-group">
                    <button type="submit" class="btn btn-danger">Delete</button>
                    <a href="@Url.Action("Index")" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
