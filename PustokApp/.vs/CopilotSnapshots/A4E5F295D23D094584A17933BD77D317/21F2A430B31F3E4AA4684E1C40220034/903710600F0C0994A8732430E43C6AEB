@model PustokApp.Models.Author
@{
    ViewData["Title"] = "Author Details";
}

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">Author Details</h1>
        <a href="@Url.Action("Index")" class="d-none d-sm-inline-block btn btn-sm btn-secondary shadow-sm">
            <i class="fas fa-arrow-left"></i> Back to Authors
        </a>
    </div>

    <div class="row">
        <div class="col-md-4">
            <div class="card shadow mb-4">
                <div class="card-body text-center">
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl" alt="@Model.FullName" class="img-fluid rounded mb-3" style="max-height: 300px;">
                    }
                    else
                    {
                        <div class="alert alert-light">
                            <i class="fas fa-image fa-3x text-muted"></i>
                            <p class="text-muted">No Image</p>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-8">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Author Information</h6>
                </div>
                <div class="card-body">
                    <div class="form-group">
                        <label class="control-label font-weight-bold">Full Name</label>
                        <p class="form-control-static">@Model.FullName</p>
                    </div>

                    <div class="form-group">
                        <label class="control-label font-weight-bold">Author ID</label>
                        <p class="form-control-static">@Model.Id</p>
                    </div>

                    <div class="form-group">
                        <label class="control-label font-weight-bold">Image URL</label>
                        <p class="form-control-static">
                            @if (!string.IsNullOrEmpty(Model.ImageUrl))
                            {
                                <a href="@Model.ImageUrl" target="_blank">@Model.ImageUrl</a>
                            }
                            else
                            {
                                <span class="text-muted">N/A</span>
                            }
                        </p>
                    </div>

                    <div class="form-group">
                        <label class="control-label font-weight-bold">Total Books</label>
                        <p class="form-control-static">
                            @if (Model.Books != null)
                            {
                                <span class="badge badge-primary badge-lg">@Model.Books.Count</span>
                            }
                            else
                            {
                                <span class="badge badge-secondary">0</span>
                            }
                        </p>
                    </div>
                </div>
            </div>

            @if (Model.Books != null && Model.Books.Count > 0)
            {
                <div class="card shadow mb-4">
                    <div class="card-header py-3">
                        <h6 class="m-0 font-weight-bold text-primary">Books by This Author</h6>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered">
                                <thead>
                                    <tr>
                                        <th>Book Name</th>
                                        <th>Price</th>
                                        <th>Stock</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var book in Model.Books)
                                    {
                                        <tr>
                                            <td>@book.Name</td>
                                            <td>@book.Price</td>
                                            <td>@book.Stock</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="fas fa-info-circle"></i> This author has no books yet.
                </div>
            }

            <div class="mt-3">
                <a href="@Url.Action("Edit", new { id = Model.Id })" class="btn btn-warning">
                    <i class="fas fa-edit"></i> Edit
                </a>
                <a href="@Url.Action("Index")" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Back
                </a>
            </div>
        </div>
    </div>
</div>
