@model List<PustokApp.Models.Author>
@{
    ViewData["Title"] = "Authors";
}

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">Authors</h1>
        <a href="@Url.Action("Create")" class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm">
            <i class="fas fa-plus fa-sm text-white-50"></i> Create
        </a>
    </div>

    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Authors List</h6>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Full Name</th>
                            <th>Books Count</th>
                            @* <th>Image</th> *@
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Count > 0)
                        {
                            @foreach (var author in Model)
                            {
                                <tr id="row-@author.Id">
                                    <td>@author.Id</td>
                                    <td>@author.FullName</td>
                                    <td>
                                        @if (author.Books != null)
                                        {
                                            <span class="badge badge-primary">@author.Books.Count</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-secondary">0</span>
                                        }
                                    </td>
                                    <td>
                                        <a href="@Url.Action("Edit", new { id = author.Id })" class="btn btn-sm btn-warning">Edit</a>
                                        <a href="@Url.Action("Details", new { id = author.Id })" class="btn btn-sm btn-info">Details</a>
                                        <button type="button" class="btn btn-sm btn-danger deleteBtn" data-id="@author.Id" data-name="@author.FullName">Delete</button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted">No authors found</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    document.querySelectorAll('.deleteBtn').forEach(button => {
        button.addEventListener('click', function() {
            const authorId = this.getAttribute('data-id');
            const authorName = this.getAttribute('data-name');

            Swal.fire({
                title: 'Are you sure?',
                text: `You are about to delete "${authorName}". This action cannot be undone!`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    // Make AJAX call to delete
                    fetch(`/Manage/Authors/Delete/${authorId}`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        }
                    })
                    .then(response => {
                        if (response.ok) {
                            Swal.fire(
                                'Deleted!',
                                `"${authorName}" has been deleted successfully.`,
                                'success'
                            ).then(() => {
                                // Remove row from table
                                const row = document.getElementById(`row-${authorId}`);
                                if (row) {
                                    row.remove();
                                }
                                // Reload page after 1 second
                                setTimeout(() => {
                                    location.reload();
                                }, 1000);
                            });
                        } else {
                            Swal.fire('Error!', 'Failed to delete author.', 'error');
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        Swal.fire('Error!', 'An error occurred.', 'error');
                    });
                }
            });
        });
    });
</script>

        </div>
    </div>
</div>
@section Scripts {
    <script>
        $(.deleteAuthor).click(function (e) {
             e.preventDefault();
                     Swal.fire({
          title: "Do you want to delete this author?",
          showDenyButton: true,
          showCancelButton: true,
          confirmButtonText: "Delete",
          denyButtonText: `Don't delete`
        }).then((result) => {
          /* Read more about isConfirmed, isDenied below */
          if (result.isConfirmed) {
              //author/delete/id
              var url = $(this).attr('href');
              $.ajax({
                  url: url,
                  type: 'get',
                  success: function () {
                          Swal.fire("Author deleted successfully!", "", "success").then(() => {
                              location.reload();
                  },
                  error: function () {
                      Swal.fire("An error occurred while deleting the author.", "", "error");
                  }
              });
          }
          
          else if (result.isDenied) Swal.fire("Changes are not saved", "", "info");
        });
         });
    </script>
}
